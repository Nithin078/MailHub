# Copy to .env. Never commit .env.
# Local demo works with the defaults: SQLite, no Google, no Firebase.
# Docker Compose overrides DATABASE_URL and REDIS_URL.

DEMO_MODE=true
INLINE_WORKER=true
SECRET_KEY=replace-with-a-long-random-string
# Production (DEMO_MODE=false) must set this. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./inboxagent.db
REDIS_URL=
QUEUE_BACKEND=auto
PUBLIC_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Cloud OAuth client. Scope on first connect is gmail.readonly only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/accounts/connect/callback

# projects/PROJECT/topics/gmail-push
PUBSUB_TOPIC=
# Audience configured on the push subscription, usually the webhook URL.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=
# Shared secret on the push URL as ?token=...
PUBSUB_VERIFICATION_TOKEN=

# Firebase Cloud Messaging HTTP v1. Leave blank to keep notifications in the app only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Used by the edge profile: docker compose --profile edge up
SITE_ADDRESS=mail.solarquack.in
